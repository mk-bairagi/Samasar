<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon background: the same violet-to-blue the app's ambient field drifts through,
  pushed to full saturation so the mark still reads at 48dp on a busy home screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF5B2BD9" />
                <item android:offset="0.55" android:color="#FF3A46E0" />
                <item android:offset="1.0" android:color="#FF2B7BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular sweep: the glass cue the whole app is built on, at icon scale. -->
    <path android:pathData="M0,74 C30,56 62,52 108,60 L108,0 L0,0 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="14" android:startY="8"
                android:endX="80" android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#33FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
