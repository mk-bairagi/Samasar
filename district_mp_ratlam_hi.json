oads/2026/08/rt2110.webp","source":"पत्रिका","published_at":1787326577,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/award-of-excellence-20850743"}]},{"id":"36c4964450d2b044c9cbf4ede80d93a4e55d1a37","title":"रतलाम छात्रावास के नाराज छात्रों का कलेक्टोरेट में धरना","summary":"रतलाम. कलेक्ट्रेट परिसर में गुरुवार को छात्रावास के छात्रों ने छात्रावास में अव्यवस्थाओं का विरोध करते हुए कलेक्टोरेट में धरना दे दिया। ग्रामीणों, संत-महात्माओं, किसानों ने विभिन्न मांगों को लेकर प्रदर्शन किया। पूरा दिन मौन विरोध, नारेबाजी और ज्ञापन सौंपने, आश्वासन के नाम रहा।","url":"https://patrika.com/ratlam-news/ratlam-collector-student-news-20848263","image":"https://cms.patrika.com/wp-content/uploads/2026/08/Student-News-ratlam.webp","source":"पत्रिका","published_at":1787247132,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/ratlam-collector-student-news-20848263"}]},{"id":"03a567b632f790ead083d06e7151e488e7771469","title":"रतलाम फार्मर रजिस्ट्री में लापरवाही, दो पटवारी निलंबित कामकाज ठप","summary":"रतलाम. जिले में किसान रजिस्ट्री कार्य में लापरवाही बरतने पर अनुविभागीय अधिकारी राजस्व उपखंड जावरा और सैलाना ने दो पटवारियों को निलंबित किया है। दोनों पर शासकीय दायित्वोंं के निर्वहन में उदासीनता और कारण बताओ नोटिस का जवाब नहीं देने का आरोप है।","url":"https://patrika.com/ratlam-news/negligence-in-farmer-registry-two-patwaris-suspended-20848240","image":"https://cms.patrika.com/wp-content/uploads/2026/08/Patwari-Association-news-ratlam.webp","source":"पत्रिका","published_at":1787245126,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/negligence-in-farmer-registry-two-patwaris-suspended-20848240"}]},{"id":"affc0743a9a6e312935a60346c1bd7ca93221a89","title":"ठेला व्यापारियों को बड़ी राहत, कोर्ट ने कहा 27 तक नहीं उठाए कोई कदम","summary":"रतलाम. दो बत्ती चौपाटी से स्ट्रीट वेंडरों (छोटे ठेला व्यवसायियों) को बेदखल करने और नगर निगम ने बिना किसी नोटिस की गई तोडफ़ोड़ की कार्रवाई के मामले में व्यापारियों को बड़ी राहत मिली है। निगम प्रशासन की इस कार्रवाई के खिलाफ कानूनी लड़ाईलड़ रहे ठेला व्यापारी संघ को न्यायालय से स्टे मिल गया है। इस मामले में अगली सुनवाई 27 अगस्त तय की गई है। स्टे मिलने के बाद ठेला व्यवसायियों ने इसे संघर्ष की जीत बताया","url":"https://patrika.com/ratlam-news/ratlam-news-20848226","image":"https://cms.patrika.com/wp-content/uploads/2026/08/rt2005.webp","source":"पत्रिका","published_at":1787245025,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/ratlam-news-20848226"}]},{"id":"0322f09349fd20cc4d9b87c7ad8b5fab87e697cf","title":"रतलाम : पानी पतासे के 20 रुपए के लिए चले लातघूसे","summary":"रतलाम. शहर के संत रविदास चौक क्षेत्र में बुधवार रात पानी पतासे के पैसों को लेकर दुकानदार और ग्राहक के बीच हुए विवाद ने मारपीट का रूप ले लिया। देखते ही देखते दोनों पक्षों के बीच लातघूसे चलने लगे। इस घटना में चाट दुकानदार का बेटा और 2 ग्राहक घायल हो गए। दोनों पक्षों ने माणकचौक पुलिस थाने में एक-दूसरे के खिलाफ शिकायत दर्ज कराई है। पुलिस ने केस दर्ज करके मामले की जांच में जुटी है।","url":"https://patrika.com/ratlam-news/ratlam-news-20848181","image":"https://cms.patrika.com/wp-content/uploads/2026/08/101.webp","source":"पत्रिका","published_at":1787243115,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/ratlam-news-20848181"}]},{"id":"5584949719810fe098abd820b2ac598389b6221b","title":"Ratlam News: रक्षाबंधन पर रेलवे की सौगात, 9 जोड़ी स्पेशल ट्रेनों के फेरे विस्तारित","summary":"Ratlam Railway Special Trains 2026: रक्षाबंधन के त्योहार पर ट्रेनों में बढ़ने वाली यात्रियों की भीड़ को देखते हुए भारतीय रेलवे ने मध्यप्रदेश के यात्रियों को बड़ी सौगात दी है। पश्चिम रेलवे द्वारा यात्रियों की सुविधा तथा बढ़ती यात्रा मांग को ध्यान में रखते हुए विशेष किराये पर संचालित 9 जोड़ी स्पेशल ट्रेनों के फेरे पुनः विस्तारित किए गए हैं। इसके साथ ही बांद्रा टर्निनस-बीकानेर साप्ताहिक एक्सप्रेस का ","url":"https://patrika.com/ratlam-news/raksha-bandhan-special-trains-2026-indian-railway-20848149","image":"https://cms.patrika.com/wp-content/uploads/2026/08/indian-railway.webp","source":"पत्रिका","published_at":1787239879,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/raksha-bandhan-special-trains-2026-indian-railway-20848149"}]},{"id":"e6e43353be07a0c005cf4e54fc8c09e2544487aa","title":"रतलाम में बिजली तार चोरी करने वाला गिरोह गिरफ्तार","summary":"रतलाम. पुलिस ने बिजली के तार चोरी करने वाले गिरोह का पर्दाफाश करते हुए चार आरोपियों को गिरफ्तार किया है। पुलिस ने आरोपियों के कब्जे से चोरी में प्रयुक्त वाहन तथा करीब 10 लाख रुपए कीमत का माल बरामद है।","url":"https://patrika.com/ratlam-news/ratlam-mein-bijli-taar-chori-karne-wala-giroh-pakda-20845507","image":"https://cms.patrika.com/wp-content/uploads/2026/08/ratlam-bijli-cori-news.webp","source":"पत्रिका","published_at":1787159695,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/ratlam-mein-bijli-taar-chori-karne-wala-giroh-pakda-20845507"}]},{"id":"4df3b47504bf8ba3afa162bf3a7a633464aaaffc","title":"रतलाम मंडी में प्याज की बंपर आवक, महू-नीमच रोड जाम","summary":"रतलाम। महू-नीमच रोड स्थित कृषि उपज मंडी में प्याज की भारी आवक के कारण मार्ग पर जाम लग गया। मंडी से प्रताप नगर ब्रीज और सालाखेड़ी चौराहे तक सैकड़ों की संख्या में प्याज से भरी ट्रॉलियां सडक़ किनारे रेंगती हुई दिखाई दीं, जिससे परिसर में पहुंचने में विलंब हुआ।","url":"https://patrika.com/ratlam-news/ratlam-mandi-mein-pyaj-ki-bumper-aavak-20845438","image":"https://cms.patrika.com/wp-content/uploads/2026/08/ratlam-mandi-news.webp","source":"पत्रिका","published_at":1787158185,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/ratlam-mandi-mein-pyaj-ki-bumper-aavak-20845438"}]},{"id":"c7c9827dab678da43aabcc11748a9a478831cb5c","title":"Ratlam News: खरीदने के 18 दिन बाद ई-स्कूटी में विस्फोट, मां और दो बेटियां झुलसीं","summary":"Ratlam E Scooter Blast: मध्यप्रदेश के रतलाम में बुधवार सुबह उस वक्त बड़ा हादसा हो गया जब शहर के कनेरी रोड पर स्थित विंध्यवासिनी कॉलोनी के एक मकान में रखी ई-स्कूटी में ब्लास्ट हो गया। ई-स्कूटी घर के अंदर रखी हुई थी और जब उसमें विस्फोट हुआ तो घर में महिला के साथ उसकी दोनों बेटियां मौजूद थीं, तीनों आग में झुलस गईं हैं। ब्लास्ट के बाद भड़की आग ने घर को भी अपनी चपेट में ले लिया, जिसके कारण घर में रखा प","url":"https://patrika.com/ratlam-news/e-scooter-blast-mother-two-daughters-injured-20845326","image":"https://cms.patrika.com/wp-content/uploads/2026/08/ratlam-e-scooty-blast.webp","source":"पत्रिका","published_at":1787153132,"source_count":1,"single_source":true,"primary_source":false,"lead_eligible":true,"origin":"district","sources":[{"name":"पत्रिका","url":"https://patrika.com/ratlam-news/e-scooter-blast-mother-two-daughters-injured-20845326"}]},{"id":"1d04954c19ee08c1d5f6ed8945dc0ed7be4e92ea","title":"Ratlam News : रतलाम जिला पंचायत के परियोजना अधिकारी की सेवा समाप्त, आधा वेतन राजसात","summary":"रतलाम. रतलाम जिला पंचायत सीईओ वैशाली जैन ने परियोजना अधिकारी (वाटरशेड) महेश कुमार चौबे की संविदा सेवाएं तत्काल प्रभाव से समाप्त कर दी हैं। उनके जांच अवधि के 50 प्रतिशत मासिक पारिश्रमिक को भी स्थायी रूप से राज्य शासन के पक्ष में राजसात किया गया है। यह निर्णय शासकीय कार्यों में घोर लापरवाही, उदासीनता और पदीय कर्तव्यों के प्रति अनिच्छा के कारण किया गया। इस आदेश के जारी होने के बाद जिला पंचायत में हड़","url":"https://patrika.com/ratlam-news/services-of-ratlam-distric